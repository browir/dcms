# .env.testing.example
# Salin file ini ke .env.testing dan sesuaikan nilainya.
# File .env.testing TIDAK di-commit ke git (ada di .gitignore).
#
# Digunakan untuk:
#   - php artisan test --configuration=phpunit.mysql.xml (test konkurensi MySQL)
#   - php artisan migrate --env=testing (migration ke dcms_test)
#
# PENTING:
#   - DB_DATABASE WAJIB diisi dcms_test (atau nama lain bukan "dcms")
#   - Jangan isi APP_KEY dengan key production
#   - APP_KEY di sini tidak dipakai phpunit.xml (sudah diset langsung di sana)
#
# Setup database:
#   CREATE DATABASE IF NOT EXISTS dcms_test
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   php artisan migrate --env=testing

APP_ENV=testing

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dcms_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
